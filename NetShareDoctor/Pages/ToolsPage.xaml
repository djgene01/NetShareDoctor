<UserControl x:Class="NetShareDoctor.Pages.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" AutomationProperties.Name="Search commands"/>
                    <TextBlock Text="Search commands" Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ListBox x:Name="ToolList" BorderThickness="0" SelectionChanged="ToolList_SelectionChanged"
                         MouseDoubleClick="Run_Click" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                               Margin="6,12,0,4" FontSize="12"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,5"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel Margin="0,0,200,0">
                        <TextBlock x:Name="ToolTitle" Text="Pick a command" Style="{StaticResource Heading}" Margin="0"/>
                        <TextBlock x:Name="ToolDescription" Style="{StaticResource Hint}" Margin="0,3,0,0"
                                   Text="Double-click a command to run it. Commands marked (admin) ask for administrator permission."/>
                        <TextBlock x:Name="ToolScript" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="Copy output" Click="Copy_Click" Margin="0,0,8,0"/>
                        <Button x:Name="RunButton" Style="{StaticResource Primary}" Content="Run" Click="Run_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBox Grid.Row="2" x:Name="OutputBox" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top" Padding="12" Background="#1E2430" Foreground="#E6E9EF"
                     BorderBrush="{StaticResource Line}"/>

            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Your own command" Style="{StaticResource Label}"/>
                    <TextBox Grid.Column="1" x:Name="CustomBox" FontFamily="{StaticResource Mono}" KeyDown="CustomBox_KeyDown"
                             ToolTip="Any PowerShell or console command, e.g. Test-NetConnection 192.168.1.20 -Port 445"/>
                    <CheckBox Grid.Column="2" x:Name="CustomAdmin" Content="As administrator" Margin="12,0"/>
                    <Button Grid.Column="3" Content="Run" Click="RunCustom_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
