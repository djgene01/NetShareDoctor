<UserControl x:Class="NetShareDoctor.Pages.DiagnosePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Can other PCs reach this one?" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Checking…"/>
                    <TextBlock x:Name="AddressText" Margin="0,10,0,0" FontFamily="{StaticResource Mono}" FontSize="14"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="CopyButton" Content="Copy report" Click="Copy_Click" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="RunButton" Style="{StaticResource Primary}" Content="Run checks again" Click="Run_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <CheckBox x:Name="ProblemsOnly" Grid.Row="1" Content="Show only things that need attention"
                  Margin="2,12,0,10" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChecksList" ItemTemplate="{StaticResource CheckTemplate}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
