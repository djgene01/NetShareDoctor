<UserControl x:Class="NetShareDoctor.Pages.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Saved connections -->
        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,0,10">
                    <TextBlock Text="Saved connections" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center"/>
                    <Button Content="+ New" HorizontalAlignment="Right" Click="New_Click"/>
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" x:Name="StoreText" Style="{StaticResource Hint}" FontSize="11" Margin="4,10,0,0"/>
                <ListBox x:Name="SavedList" BorderThickness="0" SelectionChanged="SavedList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,7"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding UncPath}" FontFamily="{StaticResource Mono}" FontSize="11"
                                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" x:Name="FormCard">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource Heading}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Name" Style="{StaticResource Label}"/>
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="3" Text="PC name or IP" Style="{StaticResource Label}"/>
                            <TextBox Grid.Column="4" x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Mono}" LostFocus="HostBox_LostFocus"
                                     ToolTip="e.g. 192.168.1.20, DESKTOP-1234, or paste \\pc\share"/>

                            <TextBlock Grid.Row="2" Text="Shared folder" Style="{StaticResource Label}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Share, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Mono}" ToolTip="Leave empty and press Show shares to pick one"/>

                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Drive letter" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Row="2" Grid.Column="4" x:Name="DriveBox" SelectedItem="{Binding DriveLetter}"/>

                            <TextBlock Grid.Row="4" Text="Username" Style="{StaticResource Label}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="PCNAME\user, or the Microsoft account email used on that PC"/>

                            <TextBlock Grid.Row="4" Grid.Column="3" Text="Password" Style="{StaticResource Label}"/>
                            <PasswordBox Grid.Row="4" Grid.Column="4" x:Name="PasswordBox"
                                         ToolTip="The account password, not a Windows PIN. Leave empty to use the saved one."/>

                            <StackPanel Grid.Row="6" Grid.ColumnSpan="5" Orientation="Horizontal">
                                <CheckBox Content="Save password in Windows Credential Manager" IsChecked="{Binding SavePassword}" Margin="0,0,20,0"/>
                                <CheckBox Content="Reconnect when I sign in" IsChecked="{Binding Reconnect}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" FontSize="12"
                                   Text="Username: an account on the other PC, as PCNAME\user or its Microsoft account email. Use the account password; a Windows PIN doesn't work over the network."/>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource Primary}" Content="Connect" Click="Connect_Click" Margin="0,0,8,6" x:Name="ConnectButton"/>
                            <Button Content="Open in Explorer" Click="Open_Click" Margin="0,0,8,6"/>
                            <Button Content="Disconnect" Click="Disconnect_Click" Margin="0,0,20,6"/>
                            <Button Content="Test this PC" Click="Test_Click" Margin="0,0,8,6" x:Name="TestButton"/>
                            <Button Content="Show shares" Click="ShowShares_Click" Margin="0,0,8,6"/>
                            <Button Content="Clear saved logins" Click="Clear_Click" Margin="0,0,20,6"
                                    ToolTip="Drops connections to this PC and deletes its saved password, so you can sign in as someone else."/>
                            <Button Content="Save" Click="Save_Click" Margin="0,0,8,6"/>
                            <Button Content="Delete" Click="Delete_Click" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0" x:Name="SharesCard" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Shares on this PC (click one to use it)" Style="{StaticResource Heading}"/>
                        <WrapPanel x:Name="SharesWrap"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="ResultsList" Margin="0,12,0,0" ItemTemplate="{StaticResource CheckTemplate}"/>

                <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Text="Log" Style="{StaticResource Heading}"/>
                            <Button Content="Clear" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,3" Click="ClearLog_Click"/>
                        </Grid>
                        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12"
                                 TextWrapping="Wrap" MinHeight="140" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" BorderThickness="0" Background="#F7F8FA"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
