<Window x:Class="NetShareDoctor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Network Share Doctor" Icon="Assets/app.ico" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}">
    <StackPanel Margin="24" Width="380">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="AppIcon" Width="64" Height="64" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Network Share Doctor" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                   Text="Finds out why PCs can't see or open each other's shared folders, fixes it, and makes connecting to shares painless."/>
        <TextBlock Margin="0,12,0,0">
            <Hyperlink NavigateUri="https://github.com/djgene01/NetShareDoctor" RequestNavigate="Link_RequestNavigate">
                github.com/djgene01/NetShareDoctor
            </Hyperlink>
        </TextBlock>
        <TextBlock x:Name="CopyrightText" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
        <Button Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Margin="0,20,0,0" MinWidth="80"/>
    </StackPanel>
</Window>
