<UserControl x:Class="NetShareDoctor.Pages.DrivesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="Page_IsVisibleChanged">
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Mapped drives and connections" Style="{StaticResource Heading}" Margin="0"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Everything this PC is connected to on other PCs. &quot;Unavailable&quot; or &quot;Disconnected&quot; means the other PC can't be reached right now."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="Open" Click="Open_Click" Margin="0,0,8,0"/>
                    <Button Content="Disconnect" Click="Disconnect_Click" Margin="0,0,8,0"/>
                    <Button Content="Save as connection" Click="SaveAs_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Primary}" Content="Refresh" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
            <ListView x:Name="DrivesList" BorderBrush="{StaticResource Line}" MouseDoubleClick="Open_Click">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Drive" Width="80" DisplayMemberBinding="{Binding Local}"/>
                        <GridViewColumn Header="Network path" Width="480" DisplayMemberBinding="{Binding Remote}"/>
                        <GridViewColumn Header="Status" Width="160" DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
