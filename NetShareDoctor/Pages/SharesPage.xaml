<UserControl x:Class="NetShareDoctor.Pages.SharesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="Page_IsVisibleChanged">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Folders this PC shares" Style="{StaticResource Heading}" Margin="0"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Hidden admin shares (C$, ADMIN$, IPC$) aren't listed. Copy a network path and paste it into Explorer on the other PC."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="Copy network path" Click="Copy_Click" Margin="0,0,8,0"/>
                        <Button Content="Open folder" Click="OpenFolder_Click" Margin="0,0,8,0"/>
                        <Button Content="Stop sharing" Click="Remove_Click" Margin="0,0,8,0"/>
                        <Button Content="Refresh" Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
                <ListView x:Name="SharesList" BorderBrush="{StaticResource Line}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Share" Width="150" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Folder" Width="260" DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="Network path" Width="240" DisplayMemberBinding="{Binding NetworkPath}"/>
                            <GridViewColumn Header="Who has access" Width="320" DisplayMemberBinding="{Binding Access}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Share a folder" Style="{StaticResource Heading}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Folder" Style="{StaticResource Label}"/>
                    <TextBox Grid.Column="1" x:Name="PathBox" FontFamily="{StaticResource Mono}"/>
                    <Button Grid.Column="2" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/>

                    <TextBlock Grid.Column="4" Text="Share name" Style="{StaticResource Label}"/>
                    <TextBox Grid.Column="5" x:Name="NameBox" FontFamily="{StaticResource Mono}"/>

                    <TextBlock Grid.Row="2" Text="Access" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <ComboBox x:Name="AccessBox" Width="150" SelectedIndex="0" Margin="0,0,8,0">
                            <ComboBoxItem Content="Read and write"/>
                            <ComboBoxItem Content="Read only"/>
                        </ComboBox>
                        <TextBlock Text="for" Style="{StaticResource Label}"/>
                        <TextBox x:Name="AccountBox" Width="200" Text="Everyone"
                                 ToolTip="Everyone, or a specific account such as PCNAME\user"/>
                    </StackPanel>
                    <CheckBox Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" x:Name="NtfsBox" IsChecked="True"
                              Content="Also set the folder's own permissions"
                              ToolTip="Windows checks two sets of permissions: the share's and the folder's. Both must allow access."/>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,180,0"/>
                    <Button Style="{StaticResource Primary}" Content="Share this folder" HorizontalAlignment="Right" Click="Add_Click" x:Name="AddButton"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
