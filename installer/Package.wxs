<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- UpgradeCode identifies the product across versions: never change it. -->
  <Package Name="Network Share Doctor"
           Manufacturer="djgene01"
           Version="$(var.Version)"
           UpgradeCode="2811AE1C-34EE-468B-9F51-A0B68192CC3C"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Network Share Doctor is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\NetShareDoctor\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/djgene01/NetShareDoctor" />
    <Property Id="ARPHELPLINK" Value="https://github.com/djgene01/NetShareDoctor" />

    <!-- Set INSTALLDESKTOPSHORTCUT=0 on the msiexec command line to skip the desktop shortcut. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Network Share Doctor" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Network Share Doctor" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />

      <Feature Id="DesktopShortcut" Title="Desktop shortcut" Level="1">
        <Level Value="0" Condition="INSTALLDESKTOPSHORTCUT = 0" />
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>

    <!-- %AppData%\NetShareDoctor (saved connections) belongs to each user and is left alone on uninstall. -->

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="Assets\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="Assets\banner.bmp" />

    <!-- "Launch" checkbox on the last page. Runs from the UI as the signed-in user, not elevated. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Network Share Doctor" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AppExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component>
        <File Id="AppExe" Source="$(var.PublishDir)\NetShareDoctor.exe" KeyPath="yes" />
      </Component>
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\NetShareDoctor.exe" />
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <!-- Shortcuts live in their own components with an HKCU key path, as Windows Installer's ICE rules require. -->
  <Fragment>
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="StartMenuShortcut" Name="Network Share Doctor" Target="[INSTALLFOLDER]NetShareDoctor.exe"
                Description="Find and fix Windows file sharing problems" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\djgene01\Network Share Doctor" Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="DesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcut" Name="Network Share Doctor" Target="[INSTALLFOLDER]NetShareDoctor.exe"
                Description="Find and fix Windows file sharing problems" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\djgene01\Network Share Doctor" Name="DesktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
